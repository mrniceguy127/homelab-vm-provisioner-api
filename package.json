{
  "name": "homelab-vm-provisioner-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express API for homelab-vm-provisioner-cli",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "lint": "node ./node_modules/eslint/bin/eslint.js src test",
    "test": "npm run lint && node ./node_modules/vitest/vitest.mjs run",
    "coverage": "npm run lint && node ./node_modules/vitest/vitest.mjs run --coverage",
    "docs:build": "node scripts/build-docs.js",
    "build": "npm run docs:build"
  },
  "dependencies": {
    "amqplib": "^0.10.3",
    "express": "^4.21.2",
    "js-yaml": "^4.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "documentation": "^14.0.3",
    "eslint": "^9.39.4",
    "supertest": "^7.1.1",
    "vitest": "^2.1.9"
  }
}
