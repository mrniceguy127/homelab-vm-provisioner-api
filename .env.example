# Environment configuration for homelab-vm-provisioner-api
# Copy this file to .env and customize as needed
# Parent workspace .env variables are loaded first, then these override them

# API server port
API_PORT=3001

# Host identifier for job queue operations
# Used to identify which host is processing jobs
HOST_ID=local

# Python provisioner virtual environment path
# Defaults to homelab-vm-provisioner-cli/homelab-vm-provisioner-cli/.venv if not set
# PROVISIONER_VENV_DIR=/custom/path/to/.venv

# Network configuration (passed to Python provisioner and API runtime)
# HLVMP_NETWORK_POOL_CIDR=10.80.0.0/16
# HLVMP_NETWORK_GROUP_PREFIX_LENGTH=28

# Database microservice URL (for async job queue)
# Start the database microservice with: cd ../homelab-vm-provisioner-db && npm start
DB_SERVICE_URL=http://localhost:3002

# Database microservice authentication (shared secret)
# Must match the password configured in the database microservice
DB_SERVICE_PASSWORD=changeme_db_secret
