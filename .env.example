# Environment configuration for homelab-vm-provisioner-api
# Copy this file to .env and customize as needed
# Parent workspace .env variables are loaded first, then these override them

# API server port
API_PORT=3001

# Host identifier for job queue operations
# Used by API to enqueue jobs and by worker to claim jobs
HOST_ID=local

# Python provisioner checkout path
# Can be relative to the workspace root or an absolute path
# Defaults to ../homelab-vm-provisioner-cli when not set
# PROVISIONER_CLI_PATH=../homelab-vm-provisioner-cli

# Python provisioner virtual environment path
# Defaults to ../homelab-vm-provisioner-cli/.venv if not set
# PROVISIONER_VENV_DIR=/custom/path/to/.venv

# Provisioner data directory
# In the workspace root .env this path is relative to the workspace root.
# When passed down to the CLI/API it is rewritten relative to the CLI checkout when possible.
# Defaults to data under the provisioner CLI checkout.
# PROVISIONER_DATA_DIR=data

# Network configuration (passed to Python provisioner and API runtime)
# HLVMP_NETWORK_POOL_CIDR=10.80.0.0/16
# HLVMP_NETWORK_GROUP_PREFIX_LENGTH=28

# Database microservice URL (for async job queue)
# Native local API: use http://localhost:3002
# API container on Linux: use http://172.17.0.1:3002 to reach the host
DB_SERVICE_URL=http://172.17.0.1:3002

# Database microservice authentication (shared secret)
# Must match the password configured in the database microservice
DB_SERVICE_PASSWORD=changeme_db_secret

# Unix socket path for waking colocated worker (optional)
# If set, API will notify the worker via Unix socket after enqueueing jobs
# Must match WORKER_SOCKET in worker configuration
# Default: not set (worker uses fallback polling only)
# WORKER_SOCKET=/run/hlvmp/worker.sock
# Increase cautiously - concurrent provisioning can be resource-intensive
PROVISIONER_CONCURRENCY=1

# Worker poll interval in seconds (default: 5.0)
WORKER_POLL_INTERVAL=5.0
