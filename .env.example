# Environment configuration for homelab-vm-provisioner-api
# Copy this file to .env and customize as needed
# Parent workspace .env variables are loaded first, then these override them

# ==============================================================================
# Network Configuration
# ==============================================================================

# LOCAL_HOST: Default host/IP for service binding (inherited from parent)
# By default, scripts dynamically set this based on mode (localhost for native, 172.17.0.1 for Docker)
#LOCAL_HOST=localhost

# ==============================================================================
# API Server Configuration
# ==============================================================================

# API server port
API_PORT=3001

# ==============================================================================
# Host Identity Configuration
# ==============================================================================

# Host identifier for job queue operations
# Used by API to enqueue jobs and by worker to claim jobs
HOST_ID=local

# ==============================================================================
# Database Microservice Configuration
# ==============================================================================

# Database microservice connection
# DB_SERVICE_HOST defaults to LOCAL_HOST if not set
DB_SERVICE_HOST=localhost
DB_SERVICE_PORT=3002

# Database microservice URL is constructed from DB_SERVICE_HOST and DB_SERVICE_PORT

# Database microservice authentication (shared secret)
DB_SERVICE_PASSWORD=changeme_db_secret

# ==============================================================================
# RabbitMQ Job Queue Configuration
# ==============================================================================

# RabbitMQ connection settings
# QUEUE_HOST defaults to LOCAL_HOST if not set
#QUEUE_HOST=localhost
QUEUE_PORT=3334
QUEUE_VHOST=provisioner
QUEUE_EXCHANGE=provisioner.jobs
QUEUE_ROUTING_KEY_PREFIX=host

# RabbitMQ API publisher credentials
QUEUE_API_USER=provisioner_api
QUEUE_API_PASSWORD=change-me

# ==============================================================================
# Resource Limits Configuration
# ==============================================================================

# VM resource limits (passed to provisioner via jobs)
HLVMP_VM_MAX_RAM_MB=8192
HLVMP_VM_MAX_VCPUS=4
HLVMP_VM_MAX_DISK_GB=20

# ==============================================================================
# Network Configuration (passed to provisioner via jobs)
# ==============================================================================

# Network pool configuration (optional)
# HLVMP_NETWORK_POOL_CIDR=10.80.0.0/16
# HLVMP_NETWORK_GROUP_PREFIX_LENGTH=28
