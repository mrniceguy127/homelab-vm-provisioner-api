#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Load workspace .env first, then allow component .env to override it
if [[ -f "$WORKSPACE_ROOT/.env" ]]; then
    set -a
    source "$WORKSPACE_ROOT/.env"
    set +a
fi

if [[ -f "$SCRIPT_DIR/.env" ]]; then
    set -a
    source "$SCRIPT_DIR/.env"
    set +a
fi

API_PORT="${API_PORT:-3001}"
DB_SERVICE_PORT="${DB_SERVICE_PORT:-3002}"

log() {
    printf '==> %s\n' "$*"
}

hash_string() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum | cut -d' ' -f1
        return
    fi

    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 | cut -d' ' -f1
        return
    fi

    printf 'Missing command: sha256sum or shasum\n' >&2
    exit 1
}

docker_container_exists() {
    docker inspect "$1" >/dev/null 2>&1
}

docker_container_running() {
    [[ "$(docker inspect -f '{{.State.Running}}' "$1" 2>/dev/null || true)" == "true" ]]
}

docker_container_image_id() {
    docker inspect -f '{{.Image}}' "$1" 2>/dev/null || true
}

docker_container_label() {
    local container_name="$1"
    local label_name="$2"
    docker inspect -f "{{index .Config.Labels \"$label_name\"}}" "$container_name" 2>/dev/null || true
}

docker_image_id() {
    docker image inspect -f '{{.Id}}' "$1" 2>/dev/null || true
}

DOCKER_MODE=false

for arg in "$@"; do
    case "$arg" in
        --docker)
            DOCKER_MODE=true
            ;;
        --help)
            echo "Usage: $0 [OPTIONS]"
            echo ""
            echo "Start the API service."
            echo ""
            echo "Options:"
            echo "  --docker    Start API in Docker container"
            echo "  --help      Show this help message"
            echo ""
            echo "Default: Start API locally with npm start"
            exit 0
            ;;
    esac
done

if [[ "$DOCKER_MODE" == "true" ]]; then
    if ! command -v docker >/dev/null 2>&1; then
        log "Error: Docker not found. Install Docker Engine."
        exit 1
    fi

    if ! docker image inspect homelab-vm-provisioner-api:latest >/dev/null 2>&1; then
        log "API image not found. Building..."
        "$SCRIPT_DIR/build" --docker
    fi

    API_DB_SERVICE_URL="${DB_SERVICE_URL:-}"
    if [[ -z "$API_DB_SERVICE_URL" || "$API_DB_SERVICE_URL" == "http://localhost:$DB_SERVICE_PORT" ]]; then
        API_DB_SERVICE_URL="http://172.17.0.1:$DB_SERVICE_PORT"
    fi

    DOCKER_ENV_ARGS=(
        -e PORT="$API_PORT"
        -e DB_SERVICE_URL="$API_DB_SERVICE_URL"
        -e DB_SERVICE_PASSWORD="${DB_SERVICE_PASSWORD:-changeme_db_secret}"
        -e HOST_ID="${HOST_ID:-local}"
    )

    DESIRED_IMAGE_ID="$(docker_image_id homelab-vm-provisioner-api:latest)"
    DESIRED_CONFIG_HASH="$({
        printf 'API_PORT=%s\n' "$API_PORT"
        printf 'DB_SERVICE_URL=%s\n' "$API_DB_SERVICE_URL"
        printf 'DB_SERVICE_PASSWORD=%s\n' "${DB_SERVICE_PASSWORD:-changeme_db_secret}"
        printf 'HOST_ID=%s\n' "${HOST_ID:-local}"
    } | hash_string)"

    if docker_container_exists hlvmp-api; then
        CURRENT_IMAGE_ID="$(docker_container_image_id hlvmp-api)"
        CURRENT_CONFIG_HASH="$(docker_container_label hlvmp-api hlvmp.config-hash)"

        if [[ "$CURRENT_IMAGE_ID" == "$DESIRED_IMAGE_ID" && "$CURRENT_CONFIG_HASH" == "$DESIRED_CONFIG_HASH" ]]; then
            if docker_container_running hlvmp-api; then
                log "API container is already running and up to date"
                exit 0
            fi

            log "Starting existing up-to-date API container"
            docker start hlvmp-api >/dev/null
            exit 0
        fi

        log "Existing API container is out of date; recreating it"
        docker rm -f hlvmp-api >/dev/null 2>&1 || true
    fi

    log "Starting API container"
    log "  Port: $API_PORT"
    log "  DB Service URL: $API_DB_SERVICE_URL"

    docker run -d \
        --name hlvmp-api \
        --label hlvmp.project=homelab-vm-provisioner \
        --label "hlvmp.config-hash=$DESIRED_CONFIG_HASH" \
        -p "$API_PORT:$API_PORT" \
        "${DOCKER_ENV_ARGS[@]}" \
        homelab-vm-provisioner-api:latest >/dev/null

    log "API container ready"
    log "  Port: $API_PORT"
    exit 0
fi

log "Starting API locally"
log "  Port: $API_PORT"
PORT="$API_PORT" npm --prefix "$SCRIPT_DIR" start
