#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source component library
source "$SCRIPT_DIR/scripts/lib.sh"

# Source .env
source_env "$SCRIPT_DIR/.env"

API_PORT="${API_PORT:-3001}"
DB_SERVICE_PORT="${DB_SERVICE_PORT:-3002}"

# Parse arguments
DOCKER_MODE=false
FOLLOW_LOGS=true

for arg in "$@"; do
    case "$arg" in
        --docker) DOCKER_MODE=true ;;
        --no-follow) FOLLOW_LOGS=false ;;
        --help)
            cat <<EOF
Usage: $0 [OPTIONS]

Start the API service.

Options:
  --docker      Start API in Docker container
  --no-follow   Don't follow logs (for orchestrated startup)
  --help        Show this help message
EOF
            exit 0
            ;;
    esac
done

if [[ "$DOCKER_MODE" == "true" ]]; then
    require_cmd docker
    docker image inspect homelab-vm-provisioner-api:latest >/dev/null 2>&1 || { log "Building API image..."; "$SCRIPT_DIR/build" --docker; }
    
    # Docker mode: adjust DB_SERVICE_HOST for Docker networking
    API_DB_SERVICE_HOST="${DB_SERVICE_HOST:-localhost}"
    [[ "$API_DB_SERVICE_HOST" == "localhost" ]] && API_DB_SERVICE_HOST="172.17.0.1"
    
    DOCKER_ENV_ARGS=(
        -e PORT="$API_PORT"
        -e DB_SERVICE_HOST="$API_DB_SERVICE_HOST"
        -e DB_SERVICE_PORT="${DB_SERVICE_PORT:-3002}"
        -e DB_SERVICE_PASSWORD="${DB_SERVICE_PASSWORD:-changeme_db_secret}"
        -e HOST_ID="${HOST_ID:-local}"
        -e QUEUE_HOST="${QUEUE_HOST:-}"
        -e QUEUE_PORT="${QUEUE_PORT:-}"
        -e QUEUE_VHOST="${QUEUE_VHOST:-}"
        -e QUEUE_EXCHANGE="${QUEUE_EXCHANGE:-}"
        -e QUEUE_ROUTING_KEY_PREFIX="${QUEUE_ROUTING_KEY_PREFIX:-}"
        -e QUEUE_API_USER="${QUEUE_API_USER:-}"
        -e QUEUE_API_PASSWORD="${QUEUE_API_PASSWORD:-}"
    )

    DESIRED_IMAGE_ID="$(docker_image_id homelab-vm-provisioner-api:latest)"
    DESIRED_CONFIG_HASH="$({
        printf 'API_PORT=%s\n' "$API_PORT"
        printf 'DB_SERVICE_HOST=%s\n' "$API_DB_SERVICE_HOST"
        printf 'DB_SERVICE_PORT=%s\n' "${DB_SERVICE_PORT:-3002}"
        printf 'DB_SERVICE_PASSWORD=%s\n' "${DB_SERVICE_PASSWORD:-changeme_db_secret}"
        printf 'HOST_ID=%s\n' "${HOST_ID:-local}"
        printf 'QUEUE_HOST=%s\n' "${QUEUE_HOST:-}"
        printf 'QUEUE_PORT=%s\n' "${QUEUE_PORT:-}"
        printf 'QUEUE_VHOST=%s\n' "${QUEUE_VHOST:-}"
        printf 'QUEUE_EXCHANGE=%s\n' "${QUEUE_EXCHANGE:-}"
        printf 'QUEUE_ROUTING_KEY_PREFIX=%s\n' "${QUEUE_ROUTING_KEY_PREFIX:-}"
        printf 'QUEUE_API_USER=%s\n' "${QUEUE_API_USER:-}"
        printf 'QUEUE_API_PASSWORD=%s\n' "${QUEUE_API_PASSWORD:-}"
    } | hash_string)"

    if docker_container_exists hlvmp-api; then
        CURRENT_IMAGE_ID="$(docker_container_image_id hlvmp-api)"
        CURRENT_CONFIG_HASH="$(docker_container_label hlvmp-api hlvmp.config-hash)"

        if [[ "$CURRENT_IMAGE_ID" == "$DESIRED_IMAGE_ID" && "$CURRENT_CONFIG_HASH" == "$DESIRED_CONFIG_HASH" ]]; then
            if docker_container_running hlvmp-api; then
                log "API container already running and up to date"
                [[ "$FOLLOW_LOGS" == "true" ]] && { trap 'log "Container running. View logs: docker logs -f hlvmp-api"' EXIT INT TERM; exec docker logs -f --tail 50 hlvmp-api; } || exit 0
            fi
            log "Starting existing up-to-date API container"
            docker start hlvmp-api >/dev/null
            exit 0
        fi

        log "API container out of date; recreating"
        docker rm -f hlvmp-api >/dev/null 2>&1 || true
    fi

    log "Starting API container on port $API_PORT"
    docker run -d --name hlvmp-api --label hlvmp.project=homelab-vm-provisioner --label "hlvmp.config-hash=$DESIRED_CONFIG_HASH" -p "$API_PORT:$API_PORT" "${DOCKER_ENV_ARGS[@]}" homelab-vm-provisioner-api:latest >/dev/null
    
    log "API container started"
    if [[ "$FOLLOW_LOGS" == "true" ]]; then
        trap 'log "Container running. View logs: docker logs -f hlvmp-api"' EXIT INT TERM
        exec docker logs -f --tail 50 hlvmp-api
    fi
    exit 0
fi

log "Starting API locally on port $API_PORT"
exec PORT="$API_PORT" npm --prefix "$SCRIPT_DIR" start
