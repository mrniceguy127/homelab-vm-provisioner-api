#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source component library
source "$SCRIPT_DIR/scripts/lib.sh"

# Source .env
source_env "$SCRIPT_DIR/.env"

# Parse arguments
SKIP_NPM=false
SKIP_SYSTEM_PACKAGES=false
DOCKER_MODE=false

for arg in "$@"; do
    case "$arg" in
        --skip-npm) SKIP_NPM=true ;;
        --skip-system-packages) SKIP_SYSTEM_PACKAGES=true ;;
        --docker) DOCKER_MODE=true; SKIP_NPM=true; SKIP_SYSTEM_PACKAGES=true ;;
        --help)
            cat <<EOF
Usage: $0 [OPTIONS]

Setup the API environment.

Options:
  --skip-npm               Skip npm install
  --skip-system-packages   Skip system package installation
  --docker                 Setup for Docker mode
  --help                   Show this help message
EOF
            exit 0
            ;;
        *)
            error "Unknown option: $arg"
            exit 1
            ;;
    esac
done

cd "$SCRIPT_DIR"

# Install system packages
if [[ "$SKIP_SYSTEM_PACKAGES" == "false" ]]; then
    ensure_sudo_once "Installing system packages requires sudo."
    
    log "Installing Node.js"
    install_system_packages_nodejs
    
    log "Installing Python"
    install_system_packages_python
    
    # Install API-specific packages (libvirt, qemu, etc.)
    log "Installing API-specific system packages"
    os_id="$(detect_os)"
    case "$os_id" in
        ubuntu|debian)
            run_sudo apt-get update
            run_sudo apt-get install -y libvirt-daemon-system virtinst qemu-utils cloud-image-utils nftables wget openssh-client
            run_sudo systemctl enable --now libvirtd || true
            ;;
        fedora)
            run_sudo dnf install -y qemu-kvm libvirt virt-install qemu-img cloud-utils nftables wget openssh-clients
            run_sudo systemctl enable --now libvirtd || true
            ;;
        rhel|rocky|almalinux)
            run_sudo dnf install -y epel-release
            run_sudo dnf install -y qemu-kvm libvirt virt-install qemu-img cloud-utils nftables wget openssh-clients
            run_sudo systemctl enable --now libvirtd || true
            ;;
        arch)
            run_sudo pacman -Syu --needed --noconfirm qemu-full libvirt virt-install cloud-image-utils nftables wget openssh
            run_sudo systemctl enable --now libvirtd || true
            ;;
        *)
            log "Warning: Unsupported OS: $os_id. Install libvirt, qemu, nftables, cloud-image-utils manually."
            ;;
    esac
fi

log "Setting up API environment"

# Verify Node.js if system packages were skipped
if [[ "$SKIP_SYSTEM_PACKAGES" == "true" && "$DOCKER_MODE" == "false" ]]; then
    require_cmd node
    require_cmd npm
    NODE_VERSION=$(node -v | cut -d. -f1 | tr -d 'v')
    [[ "$NODE_VERSION" -lt 18 ]] && error "Node.js 18+ required, found: $(node -v)" && exit 1
fi

# Install npm packages
if [[ "$SKIP_NPM" == "false" ]]; then
    log "Installing npm packages"
    npm install
fi

log "API setup complete"

[[ "$DOCKER_MODE" == "true" ]] && log "Build with: ./build --docker" || log "Start with: npm start"
